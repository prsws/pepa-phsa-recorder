# Copy to .env (chmod 600) and fill in the real DSNs. Never commit .env.
# PHSA_DSN and PHSA_TEST_DSN are libpq connection strings containing the
# database password; they come from the environment only.
PHSA_DSN=postgres://phsa_app:CHANGE_ME@192.168.10.18:5432/phsa
PHSA_TEST_DSN=postgres://phsa_app:CHANGE_ME@192.168.10.18:5432/phsa_test
PHSA_HOST=127.0.0.1
PHSA_PORT=8470
